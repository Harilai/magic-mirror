[Unit]
Description=MagicMirror Chromium kiosk display
Requires=magicmirror-server.service
After=magicmirror-server.service
PartOf=magicmirror-server.service

[Service]
Type=simple
WorkingDirectory=%h/MagicMirror
Environment=MM_BROWSER_BIN=chromium
# Keep these identical to magicmirror-server.service when overriding config/port:
# Environment=MM_CONFIG_FILE=%h/MagicMirror/config/config.js
# Environment=MM_PORT=8080
ExecStart=/usr/bin/env node scripts/serveronly-kiosk.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
KillMode=control-group
